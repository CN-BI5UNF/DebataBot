# 样例：复制到 ~/.config/systemd/user/karenbot.service.d/launcher.conf
# 本轮未安装、未 daemon-reload、未重启。请先把路径改成实际数据目录。
[Service]
ExecStart=
ExecStart=/usr/local/lib/karen/trusted_launcher.py --project-root /home/kickpi/KarenBot --data-dir /home/kickpi/.local/share/KarenBot/instances/default -- /home/kickpi/KarenBot/.venv/bin/python /home/kickpi/KarenBot/main.py --host 0.0.0.0 --port 8000
