# KarenBot —— systemd 系统级服务模板
#
# 适用于服务器/多用户环境，服务以专用用户运行。安装：
#   sudo useradd --system --create-home --shell /usr/sbin/nologin karen
#   sudo mkdir -p /opt/KarenBot
#   sudo chown -R karen:karen /opt/KarenBot
#   # 以 karen 用户完成部署和 uv sync 后：
#   sudo cp scripts/systemd/karenbot.system.service /etc/systemd/system/karenbot.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now karenbot
#
# 请按实际路径/用户修改 WorkingDirectory、ExecStart、User、Group。
# 默认同时启动 WebUI 和 QQ Runtime；只跑 headless Runtime 时加 --no-gui。

[Unit]
Description=KarenBot (WebUI + QQ runtime)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=karen
Group=karen
WorkingDirectory=/opt/KarenBot
ExecStart=/opt/KarenBot/.venv/bin/python /opt/KarenBot/main.py --host 0.0.0.0 --port 8000
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/karenbot.env
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
